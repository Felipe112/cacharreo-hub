---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — cacharreo.dev`} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    {post.data.date && (
      <p class="lead">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es', { dateStyle: 'long', timeZone: 'UTC' })}
        </time>
      </p>
    )}
    <Content />
    {post.data.autor && (
      <p class="atribucion">
        — {post.data.autor}{post.data.fuente && <cite>, {post.data.fuente}</cite>}
      </p>
    )}
  </article>
</Base>
