---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { ordenarEscritos } from '../../lib/escritos';

const posts = ordenarEscritos(await getCollection('blog'));
---

<Base
  title="Escritos — cacharreo.dev"
  description="Notas y opiniones sobre los proyectos: qué funcionó, qué no y qué aprendí."
>
  <div class="hero">
    <h1>Escritos</h1>
    <p class="lead">
      Notas y opiniones sobre el proceso. Qué funcionó, qué no, y qué aprendí
      en el intento.
    </p>
  </div>

  {posts.length > 0 ? (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          {post.data.date && (
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('es', { dateStyle: 'short', timeZone: 'UTC' })}
            </time>
          )}
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="vacio">Nada escrito todavía.</p>
  )}
</Base>
