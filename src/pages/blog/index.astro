---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Escritos — cacharreo.dev"
  description="Notas y opiniones sobre los proyectos: qué funcionó, qué no y qué aprendí."
>
  <div class="hero">
    <h1>Escritos</h1>
    <p class="lead">
      Notas y opiniones sobre el proceso. Qué funcionó, qué no, y qué aprendí
      en el intento.
    </p>
  </div>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es', { dateStyle: 'short', timeZone: 'UTC' })}
        </time>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
