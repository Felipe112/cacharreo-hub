---
import Base from '../layouts/Base.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import { getCollection } from 'astro:content';
import proyectos from '../data/proyectos.json';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="cacharreo.dev — proyectos de Andrés F. Ceballos"
  description="Cacharreo: proyectos libres, herramientas y experimentos."
>
  <div class="hero">
    <span class="badge">Andrés F. Ceballos</span>
    <h1>Cacharrear es armar cosas que <span class="em">nadie pidió</span>.</h1>
    <p class="lead">
      Acá reúno los proyectos libres, herramientas y experimentos que voy
      armando.
    </p>
  </div>

  <div class="rule"><h2>Proyectos</h2></div>

  <ul class="grid">
    {proyectos.map((p, i) => (
      <li class="card">
        <ProjectIcon variant={i} />
        <h3><a href={p.url}>{p.nombre}</a></h3>
        <p>{p.descripcion}</p>
        <div class="meta">
          {p.estado && <span>{p.estado}</span>}
          {p.repo && <a href={p.repo}>código</a>}
        </div>
      </li>
    ))}
    <li class="card next">+ el que sigue</li>
  </ul>

  <div class="rule"><h2>Escritos</h2></div>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es', { dateStyle: 'short', timeZone: 'UTC' })}
        </time>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>

  <div class="apoyar">
    <h2>Apoyar el cacharreo</h2>
    <p>
      Todo es gratis y va a seguir siéndolo. Si algo te sirvió, un aporte ayuda
      a que salgan más.
    </p>
    <a class="btn" href="/apoyar">Aportar</a>
  </div>
</Base>
