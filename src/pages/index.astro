---
import Base from '../layouts/Base.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ordenarEscritos } from '../lib/escritos';

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => (a.data.orden ?? Infinity) - (b.data.orden ?? Infinity),
);

const posts = ordenarEscritos(await getCollection('blog')).slice(0, 3);
---

<Base
  title="cacharreo.dev — proyectos de Andrés F. Ceballos"
  description="Cacharreo: proyectos libres, herramientas y experimentos."
>
  <div class="hero">
    <span class="badge">Andrés F. Ceballos</span>
    <h1>Cacharrear es tener una idea y <span class="em">negarse a dejarla en paz</span>.</h1>
    <p class="lead">
      Acá reúno los proyectos libres, herramientas y experimentos que voy
      creando.
    </p>
  </div>

  <div class="rule"><h2>Proyectos</h2></div>

  {proyectos.length > 0 ? (
    <ul class="grid">
      {proyectos.map(({ data: p }, i) => (
        <li class="card">
          {p.imagen ? (
            <a
              class="captura-link"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                class="captura"
                src={p.imagen}
                alt={p.imagenAlt ?? ''}
                widths={[400, 800]}
                sizes="(max-width: 640px) 100vw, 22rem"
                loading="lazy"
                decoding="async"
              />
            </a>
          ) : (
            <ProjectIcon variant={i} />
          )}
          <h3>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${p.nombre} (abre en una pestaña nueva)`}
            >{p.nombre}</a>
          </h3>
          <p>{p.descripcion}</p>
          <div class="meta">
            {p.estado && <span>{p.estado}</span>}
            {p.repo && (
              <a
                href={p.repo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Código de ${p.nombre} (abre en una pestaña nueva)`}
              >código</a>
            )}
          </div>
        </li>
      ))}
      <li class="card next">+ el que sigue</li>
    </ul>
  ) : (
    <p class="vacio">Todavía no hay nada publicado acá. Está en camino.</p>
  )}

  <div class="rule"><h2>Escritos</h2></div>

  {posts.length > 0 ? (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          {post.data.date && (
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('es', { dateStyle: 'short', timeZone: 'UTC' })}
            </time>
          )}
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="vacio">Nada escrito todavía.</p>
  )}
</Base>
