---
import Base from '../layouts/Base.astro';
---

<Base title="404 — cacharreo.dev" description="Esta página no existe.">
  <div class="hero">
    <span class="badge">Error 404</span>
    <h1>Esta página no <span class="em">existe</span>.</h1>
    <p class="lead">
      O existía y la moví. Pasa cuando uno cacharrea.
    </p>
  </div>

  <div class="apoyar">
    <p>¿Buscabas algo puntual?</p>
    <a class="btn" href="/">Volver al inicio</a>
  </div>
</Base>
